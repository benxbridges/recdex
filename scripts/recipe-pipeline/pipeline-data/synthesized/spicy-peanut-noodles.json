  "steps": [
    { "step": 1, "text": "Cook noodles according to package directions. Drain and rinse under cold running water until completely cool. Shake off excess water.", "timer_minutes": 8 },
    { "step": 2, "text": "While the noodles cook, whisk peanut butter, soy sauce, rice vinegar, sesame oil, chili crisp, honey, garlic, and ginger in a large bowl. Thin with warm water, a tablespoon at a time, until the sauce is pourable but still thick enough to cling.", "timer_minutes": null },
